---
import Catalog from '../../components/Catalog.astro';
import { published } from '../../landings';

export const getStaticPaths = () => published.map((landing) => ({ params: { slug: landing.fr.slug }, props: { key: landing.key } }));
const landing = published.find((l) => l.key === Astro.props.key);
---
<Catalog locale="fr" landing={landing} />
