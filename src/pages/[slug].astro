---
import Catalog from '../components/Catalog.astro';
import { allPages } from '../landings';

export const getStaticPaths = () => allPages.map((landing) => ({ params: { slug: landing.en.slug }, props: { key: landing.key } }));
const landing = allPages.find((l) => l.key === Astro.props.key);
---
<Catalog locale="en" landing={landing} />
