---
// The "About" page; its text is in src/about.ts.
import Base from './Base.astro';
import { perLocale, type Locale } from '../i18n';
import { about, aboutPath } from '../about';
import { entries } from '../catalogue';
import { pathOf } from '../landings';
import { strings } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const page = about[locale];
const t = strings[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base locale={locale} title={`${page.title} — WhatDoWePlay`} desc={page.lead} paths={perLocale(aboutPath)}>
  <p class="crumb"><a href={base + pathOf(locale)}>← {t.allGames}</a></p>
  <article class="prose">
    <h1 class="need">{page.title}</h1>
    <p class="lead">{page.lead}</p>
    {page.sections(entries.length).map((s) => (
      <section>
        {s.h && <h2>{s.h}</h2>}
        {s.p.map((text) => <p set:html={text} />)}
      </section>
    ))}
  </article>
</Base>
