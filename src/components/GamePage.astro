---
// A game's own page: what the catalogue knows about it, the pages by need it belongs to,
// and similar games (rule in src/catalogue.ts).
import Base from './Base.astro';
import GameCard from './GameCard.astro';
import Icon from './Icon.astro';
import { strings, perLocale, type Locale } from '../i18n';
import { covers, range, formatDate, gamePath, similar, shotsOf, inspiredBy, isOfficial, type Entry } from '../catalogue';
import { published, pathOf } from '../landings';

interface Props { locale: Locale; g: Entry }
const { locale, g } = Astro.props;
const t = strings[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const players = range(g.players.min, g.players.max);
const minutes = `${range(g.duration.min, g.duration.max)} min`;
const names = <K extends string>(keys: string[], table: Record<K, string>) => keys.map((k) => table[k as K]).join(', ');
// The three figures people look for first. Kind and audience are not repeated here:
// the lists the game belongs to, further down, already say them.
const facts: [string, string][] = [
  [t.weAre, players],
  [t.weHave, minutes],
  [t.inLang, names(g.languages, t.languages)],
];
// Practical points in one line: [fine as it is?, wording].
const practical: [boolean, string][] = [
  g.free ? [true, t.flags.free] : [false, t.fact.paid],
  g.noAccount ? [true, t.fact.noAccount] : [false, t.fact.needsAccount],
  g.mobile ? [true, t.fact.anyDevice] : [false, t.fact.computerOnly],
  g.sharedScreen ? [false, t.fact.screenNeeded] : [true, t.flags.noscreen],
];
const origin = inspiredBy(g).join(', ');
const checked = formatDate(locale, g.lastOk);
const tested = formatDate(locale, g.tested);
const lists = published.filter((l) => l.match(g));
const alike = similar(g);
const shots = shotsOf(g.id);
const counted = { 'data-goatcounter-click': `open/${g.id}`, 'data-goatcounter-title': g.name };
---
<Base
  locale={locale}
  title={t.gameTitle(g.name)}
  desc={`${g.desc[locale]} ${t.gameDesc(players, minutes)}`}
  paths={perLocale((l) => gamePath(l, g.id))}
>
  <p class="crumb"><a href={base + pathOf(locale)}>← {t.allGames}</a></p>

  <article class="sheet">
    <a class:list={['cover', `k-${g.types[0]}`, { photo: covers.has(g.id) }]} href={g.url} {...counted} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
      {covers.has(g.id)
        ? <img src={`${base}/covers/${g.id}.webp`} alt="" width="480" height="300" decoding="async" />
        : <span>{g.name}</span>}
    </a>
    <div>
      <h1 class="need">{g.name}</h1>
      <p class="lead">{g.desc[locale]}</p>
      {origin && <p class="origin">{isOfficial(g) ? t.fact.officialOf : t.fact.inspiredBy} <strong>{origin}</strong></p>}
      {g.offline
        ? <p class="notice"><span class="pill down">{t.offline}</span> {t.offlineSince(formatDate(locale, g.offlineSince) ?? '')}</p>
        : <a class="go" href={g.url} {...counted} target="_blank" rel="noopener">{t.open(g.name)}</a>}
    </div>
  </article>

  <dl class="facts">
    {facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
  </dl>
  <ul class="practical">
    {practical.map(([fine, label]) => <li class:list={{ warn: !fine }}>{fine && <Icon name="check" />}{label}</li>)}
  </ul>
  <p class="checks">
    {checked && !g.offline && <span><Icon name="shield" />{t.linkChecked(checked)}</span>}
    {tested && <span><Icon name="check" />{t.testedOn(tested)}</span>}
  </p>

  {shots.length > 0 && (
    <section class="shots">
      <h2>{t.shots}</h2>
      <ul>
        {shots.map((file, i) => (
          <li><a href={`${base}/shots/${file}`} target="_blank" rel="noopener"><img src={`${base}/shots/${file}`} alt={t.shotAlt(g.name, i + 1)} loading="lazy" decoding="async" /></a></li>
        ))}
      </ul>
    </section>
  )}

  {lists.length > 0 && (
    <nav class="browse" aria-labelledby="lists-title">
      <h2 id="lists-title">{t.inLists(g.name)}</h2>
      <ul>
        {lists.map((l) => <li><a href={base + pathOf(locale, l)}>{l[locale].label}</a></li>)}
      </ul>
    </nav>
  )}

  {alike.length > 0 && (
    <section class="alike">
      <h2>{t.similarTo(g.name)}</h2>
      <ol class="games">
        {alike.map((s, i) => <GameCard g={s} i={i} locale={locale} fav={false} />)}
      </ol>
    </section>
  )}
</Base>
