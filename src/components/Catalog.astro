---
import Base from './Base.astro';
import GameCard from './GameCard.astro';
import Icon from './Icon.astro';
import { strings, perLocale, TYPES, AUDIENCES, LANGUAGES, type Locale } from '../i18n';
import { entries, lastCheck, daysAgo, formatDate, similar } from '../catalogue';
import { published, likePages, pathOf, type Landing } from '../landings';

// Without `landing` this is the home page with every game; with one, a page by need (src/landings.ts).
interface Props { locale: Locale; landing?: Landing }
const { locale, landing } = Astro.props;
const page = landing?.[locale];
const t = strings[locale];

const visible = entries.filter((g) => !landing || landing.match(g));
const lastAdded = visible.map((g) => g.added).sort().pop() || '';
const lastBatch = lastAdded && daysAgo(lastAdded) <= 30 ? visible.filter((g) => g.added === lastAdded).length : 0;
// On a "games like …" page, which is often short: a few more games of the same kind.
const also = landing?.like && visible.length ? similar(visible[0], 12).filter((g) => !visible.includes(g)).slice(0, 4) : [];
const usedTypes = TYPES.filter((x) => visible.some((g) => g.types.includes(x)));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const metaTitle = page ? `${page.h1} — WhatDoWePlay` : t.metaTitle;
const metaDesc = page ? `${page.lead} ${t.pageDesc(visible.length)}` : t.metaDesc;
const durations = [10, 20, 30];
const perkIcons = ['shield', 'check', 'monitor', 'users'];
---
<Base locale={locale} title={metaTitle} desc={metaDesc} paths={perLocale((l) => pathOf(l, landing))}>
  <section class="hero">
    <div>
      {page
        ? <h1 class="need">{page.h1}</h1>
        : <h1>{t.titleA}<span class="mark">{t.titleMark}</span>{t.titleEnd}</h1>}
      <p class="lead">{page ? page.lead : t.lead}</p>
    </div>
    <svg class="art" viewBox="0 0 200 150" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <g class="sparks"><path d="M150 22l6-16M166 30l14-12M172 46l18-4" /></g>
      <g transform="rotate(-8 100 85)">
        <rect x="42" y="34" width="112" height="76" rx="8" />
        <path d="M22 112h152l-8 16H30z" />
        <circle cx="98" cy="62" r="8" /><path d="M84 88c0-9 6-14 14-14s14 5 14 14" />
        <circle cx="72" cy="68" r="6" /><path d="M60 88c0-7 5-11 12-11" />
        <circle cx="124" cy="68" r="6" /><path d="M136 88c0-7-5-11-12-11" />
      </g>
    </svg>
  </section>

  <form class="panel" id="filters" autocomplete="off" data-preset={landing?.filter} data-home={base + pathOf(locale)}>
    <div class="panel-head">
      <h2><Icon name="sliders" />{t.filterTitle}</h2>
      <button type="button" id="reset"><Icon name="reset" />{t.reset}</button>
    </div>

    <fieldset>
      <legend><Icon name="users" />{t.forWhom}</legend>
      <div class="chips">
        {AUDIENCES.map((a) => <label class="chip"><input type="checkbox" name="for" value={a} /><span>{t.audience[a]}</span></label>)}
      </div>
    </fieldset>
    <fieldset>
      <legend><Icon name="gamepad" />{t.kind}</legend>
      <div class="chips">
        {usedTypes.map((x) => <label class={`chip k-${x}`}><input type="checkbox" name="type" value={x} /><span><i class="dot"></i>{t.types[x]}</span></label>)}
      </div>
    </fieldset>
    <fieldset>
      <legend><Icon name="globe" />{t.inLang}</legend>
      <div class="chips">
        {LANGUAGES.map((l) => <label class="chip"><input type="checkbox" name="lang" value={l} /><span>{t.languages[l]}</span></label>)}
      </div>
    </fieldset>

    <div class="pair">
      <label class="field"><span><Icon name="users" />{t.weAre}</span>
        <input type="number" name="n" min="1" max="99" inputmode="numeric" placeholder="8" />
      </label>
      <label class="field"><span><Icon name="clock" />{t.weHave}</span>
        <select name="t">
          <option value="">{t.anyTime}</option>
          {durations.map((d) => <option value={d}>{t.minutes(d)}</option>)}
        </select>
      </label>
    </div>

    <div class="flags">
      {(['free', 'noaccount', 'phone', 'noscreen'] as const).map((f) => <label class="box"><input type="checkbox" name={f} value="1" /><span>{t.flags[f]}</span></label>)}
      <label class="box favs"><input type="checkbox" name="favs" value="1" /><span><Icon name="heart" />{t.favOnly}</span></label>
    </div>
  </form>

  <div class="tally">
    <strong id="count" aria-live="polite" data-one={t.count(1)} data-many={t.count(2).replace('2', '{n}')} data-zero={t.count(0)}>{t.count(visible.length)}</strong>
    {lastCheck && <span class="verified"><Icon name="shield" />{t.linksChecked(formatDate(locale, lastCheck, 'short') ?? '')}</span>}
    {lastBatch > 0 && <span class="fresh">{t.added(lastBatch, formatDate(locale, lastAdded, 'short', false) ?? '')}</span>}
    <label class="search"><Icon name="search" /><input type="search" id="q" placeholder={t.search} aria-label={t.search} autocomplete="off" /></label>
    <label class="sort">{t.sortBy}
      <select id="sort">
        {Object.entries(t.sorts).map(([v, label]) => <option value={v}>{label}</option>)}
      </select>
    </label>
  </div>

  <ol class="games" id="games">
    {visible.map((g, i) => <GameCard g={g} i={i} locale={locale} />)}
  </ol>
  <p class="none" id="none" hidden>{t.none}</p>

  {also.length > 0 && (
    <section class="alike">
      <h2>{t.sameKind}</h2>
      <ol class="games">
        {also.map((g, i) => <GameCard g={g} i={i} locale={locale} fav={false} />)}
      </ol>
    </section>
  )}

  <nav class="browse" aria-labelledby="browse-title">
    <h2 id="browse-title">{t.browse}</h2>
    <ul>
      {landing && <li><a class="all" href={base + pathOf(locale)}>{t.allGames}</a></li>}
      {published.filter((l) => l !== landing).map((l) => <li><a href={base + pathOf(locale, l)}>{l[locale].label}</a></li>)}
    </ul>
  </nav>

  <nav class="browse" aria-labelledby="like-title">
    <h2 id="like-title">{t.likeTitle}</h2>
    <ul>
      {likePages.filter((l) => l !== landing).map((l) => <li><a href={base + pathOf(locale, l)}>{l[locale].label}</a></li>)}
    </ul>
  </nav>

  <ul class="perks">
    {t.perks.map((p, i) => <li><Icon name={perkIcons[i]} />{p}</li>)}
  </ul>

  <script src="../scripts/filters.js"></script>
</Base>
